{
  "name": "codebrain-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for CodeBrain codebase intelligence",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build:ui && tsx index.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "3d-force-graph": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
