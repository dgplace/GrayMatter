FROM node:22-bookworm-slim

ARG SCIP_CLI_VERSION=v0.7.1
ARG SCIP_TYPESCRIPT_VERSION=0.4.0
ARG SCIP_PYTHON_VERSION=0.6.6
ARG SCIP_JAVA_VERSION=v0.12.3
ARG SCIP_CLANG_VERSION=v0.4.0
ARG SCIP_DOTNET_VERSION=0.2.14

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        python3 python3-pip python3-venv \
        build-essential \
        default-jre-headless \
        gpg wget && \
    rm -rf /var/lib/apt/lists/*

RUN wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb && \
    dpkg -i /tmp/packages-microsoft-prod.deb && \
    rm /tmp/packages-microsoft-prod.deb && \
    apt-get update && \
    DOTNET_SDK_PACKAGE="" && \
    for pkg in dotnet-sdk-10.0 dotnet-sdk-9.0 dotnet-sdk-8.0 dotnet-sdk-7.0; do \
      if apt-cache show "$pkg" >/dev/null 2>&1; then \
        DOTNET_SDK_PACKAGE="$pkg"; \
        break; \
      fi; \
    done && \
    if [ -z "$DOTNET_SDK_PACKAGE" ]; then \
      echo "No supported dotnet-sdk package found in Microsoft apt repo." && \
      apt-cache search dotnet-sdk && \
      exit 1; \
    fi && \
    apt-get install -y --no-install-recommends "$DOTNET_SDK_PACKAGE" && \
    rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
      amd64) SCIP_ARCH=linux-amd64 ;; \
      arm64) SCIP_ARCH=linux-arm64 ;; \
      *) echo "unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    curl -sSL "https://github.com/scip-code/scip/releases/download/${SCIP_CLI_VERSION}/scip-${SCIP_ARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin scip && \
    chmod +x /usr/local/bin/scip && \
    scip --version

RUN npm install -g "@sourcegraph/scip-typescript@${SCIP_TYPESCRIPT_VERSION}" && \
    scip-typescript --version

RUN npm install -g "@sourcegraph/scip-python@${SCIP_PYTHON_VERSION}" && \
    scip-python --version

RUN curl -sSL "https://github.com/sourcegraph/scip-java/releases/download/${SCIP_JAVA_VERSION}/scip-java-${SCIP_JAVA_VERSION}" \
      -o /usr/local/bin/scip-java && \
    chmod +x /usr/local/bin/scip-java && \
    scip-java --help > /dev/null

RUN ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "amd64" ]; then \
      curl -sSL "https://github.com/sourcegraph/scip-clang/releases/download/${SCIP_CLANG_VERSION}/scip-clang-x86_64-linux" \
        -o /usr/local/bin/scip-clang && \
      chmod +x /usr/local/bin/scip-clang && \
      scip-clang --help > /dev/null; \
    else \
      echo "Skipping scip-clang install on unsupported architecture: $ARCH"; \
    fi

ENV PATH="/root/.dotnet/tools:${PATH}"
RUN dotnet tool install --global scip-dotnet --version ${SCIP_DOTNET_VERSION} && \
    scip-dotnet --version

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /workspace

CMD ["bash"]
